def mostrar_vector(datos):
    for elemento in datos:
        print(elemento)

def media(datos):
    suma = sum(datos)
    return suma / len(datos)

# Flujo principal
pares = [2, 4, 6, 8, 10]
impares = [1, 3, 5, 7, 9]

mostrar_vector(pares)
print("Media = " + str(media(pares)))

mostrar_vector(impares)
print("Media = " + str(media(impares)))
